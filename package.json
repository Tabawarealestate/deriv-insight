{
  "name": "deriv-insight-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/analytics && npm run build -w apps/web && npm run build -w apps/api",
    "test": "npm run test -w packages/analytics",
    "typecheck": "npm run typecheck -ws",
    "start": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.21.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
